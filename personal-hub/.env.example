# =============================================================================
# PERSONAL HUB - Environment Configuration
# =============================================================================
# Copy this file to .env and update the values
# NEVER commit the .env file to version control

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME="Personal Hub"
APP_ENV=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Frontend Settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# Backend Settings
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
BACKEND_RELOAD=true

# API Prefix
API_V1_PREFIX=/api/v1

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# -----------------------------------------------------------------------------
# Database Settings (MySQL)
# -----------------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=personalhub
MYSQL_PASSWORD=your_secure_password_here
MYSQL_DATABASE=personalhub

# Database URL (constructed from above, or override directly)
DATABASE_URL=mysql+asyncmy://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}

# -----------------------------------------------------------------------------
# Redis Settings (for caching and rate limiting)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# JWT Secret Key (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256

# Token Expiration (in seconds)
ACCESS_TOKEN_EXPIRE_SECONDS=900        # 15 minutes
REFRESH_TOKEN_EXPIRE_SECONDS=604800    # 7 days

# Password Hashing
PASSWORD_HASH_ALGORITHM=argon2  # argon2 or bcrypt

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # seconds

# -----------------------------------------------------------------------------
# Initial Admin Account (created on first startup if not exists)
# -----------------------------------------------------------------------------
INIT_ADMIN_EMAIL=admin@personalhub.local
INIT_ADMIN_PASSWORD=ChangeThisPassword123!
INIT_ADMIN_NAME=Administrator

# -----------------------------------------------------------------------------
# Media Relay (go2rtc) Settings
# -----------------------------------------------------------------------------
GO2RTC_HOST=go2rtc
GO2RTC_API_PORT=1984
GO2RTC_RTSP_PORT=8554
GO2RTC_WEBRTC_PORT=8555

# -----------------------------------------------------------------------------
# DeepStream Settings
# -----------------------------------------------------------------------------
DEEPSTREAM_ENABLED=false
DEEPSTREAM_HOST=deepstream
DEEPSTREAM_PORT=8554

# Default Camera Configuration
# Format: name=rtsp://user:pass@ip:port/path
DEFAULT_CAMERA_URL=rtsp://admin:password@192.168.1.100:554/stream1
CAMERA_NAME=main_camera

# -----------------------------------------------------------------------------
# Person Detection Settings
# -----------------------------------------------------------------------------
PERSON_DETECTION_HOST=person-detection
PERSON_DETECTION_PORT=8001

# Model Configuration
YOLO_MODEL=yolov8n.pt  # yolov8n, yolov8s, yolov8m, yolov8l, yolov8x
DETECTION_CONFIDENCE=0.5
DETECTION_IOU_THRESHOLD=0.45
USE_GPU=true  # Set to false for CPU-only

# -----------------------------------------------------------------------------
# Module Settings
# -----------------------------------------------------------------------------
MODULES_DIR=/app/modules
MODULES_AUTO_LOAD=true
MODULES_HEALTH_CHECK_INTERVAL=30  # seconds

# -----------------------------------------------------------------------------
# Logging & Monitoring
# -----------------------------------------------------------------------------
LOG_FORMAT=json  # json or text
LOG_FILE=/var/log/personalhub/app.log
ENABLE_REQUEST_LOGGING=true

# Sentry (optional)
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Docker/Deployment Settings
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=personalhub
DOCKER_REGISTRY=

# GPU Settings
NVIDIA_VISIBLE_DEVICES=all
CUDA_VISIBLE_DEVICES=0

# -----------------------------------------------------------------------------
# SSL/TLS (for production)
# -----------------------------------------------------------------------------
SSL_ENABLED=false
SSL_CERT_PATH=/etc/ssl/certs/personalhub.crt
SSL_KEY_PATH=/etc/ssl/private/personalhub.key
